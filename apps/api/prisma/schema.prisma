// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum BillType {
  software
  utility
  other
}

// ── Models ─────────────────────────────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  privyUserId String   @unique @map("privy_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  wallet            Wallet?
  deposits          Deposit[]
  snapshots         YieldSnapshot[]
  bills             RecurringBill[]
  etherfuseCustomer EtherfuseCustomer?
  rampOrders        RampOrder[]
  personName         PersonName?
  ownedHousehold     Household?  @relation("HouseholdOwner")
  householdMembership HouseholdMember?
  lessonProgress     LessonProgress[]

  @@map("companies")
}

model EtherfuseCustomer {
  id            String   @id @default(cuid())
  companyId     String   @unique @map("company_id")
  customerId    String   @map("customer_id")
  bankAccountId String?  @map("bank_account_id")
  walletId      String?  @map("wallet_id")
  kycStatus     String   @default("pending") @map("kyc_status")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("etherfuse_customers")
}

model RampOrder {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  orderId         String   @unique @map("order_id")
  type            String
  status          String   @default("created")
  amountFiat      String?  @map("amount_fiat")
  amountToken     String?  @map("amount_token")
  burnTransaction String?  @map("burn_transaction")
  depositClabe    String?  @map("deposit_clabe")
  createdAt       DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("ramp_orders")
}

model Wallet {
  id             String   @id @default(cuid())
  companyId      String   @unique @map("company_id")
  stellarAddress String   @unique @map("stellar_address")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("wallets")
}

model Deposit {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  /// USDC amount in base units (7 decimal places)
  amount    BigInt
  txHash    String   @unique @map("tx_hash")
  /// Liga o depósito à order de on-ramp (jornada Pix→cofre). Null = depósito direto.
  rampOrderId String? @map("ramp_order_id")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  // principal() agrega deposits por companyId; índice evita full-scan.
  @@index([companyId])
  @@map("deposits")
}

model RecurringBill {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  vendor      String
  /// USDC amount in base units (7 decimal places)
  monthlyCost BigInt   @map("monthly_cost")
  type        BillType @default(software)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("recurring_bills")
}

model YieldSnapshot {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  /// Vault value in base units (7 decimal places)
  vaultValue BigInt   @map("vault_value")
  /// Principal in base units (7 decimal places)
  principal  BigInt
  /// Spendable yield in base units (7 decimal places)
  spendable  BigInt
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("yield_snapshots")
}

model PersonName {
  companyId   String @id @map("company_id")
  displayName String? @map("display_name")
  fullName    String? @map("full_name")
  email       String?
  company     Company @relation(fields: [companyId], references: [id])
  @@map("person_names")
}

model Household {
  id                   String   @id @default(cuid())
  name                 String
  ownerCompanyId       String   @unique @map("owner_company_id")
  householdSize        String?  @map("household_size")
  monthlyIncomeCents   Int?     @map("monthly_income_cents")
  reserveCents         Int?     @map("reserve_cents")
  priorities           String[]
  goalMonths           Int?     @map("goal_months")
  cryptoExperience     String?  @map("crypto_experience")
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  owner                Company  @relation("HouseholdOwner", fields: [ownerCompanyId], references: [id])
  members              HouseholdMember[]
  invites              HouseholdInvite[]
  statements           Statement[]
  expenses             Expense[]
  @@map("households")
}

model HouseholdMember {
  id          String @id @default(cuid())
  householdId String @map("household_id")
  companyId   String @unique @map("company_id")
  role        String
  household   Household @relation(fields: [householdId], references: [id])
  company     Company   @relation(fields: [companyId], references: [id])
  @@unique([householdId, companyId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String @id @default(cuid())
  householdId String @map("household_id")
  email       String
  status      String @default("pending")
  household   Household @relation(fields: [householdId], references: [id])
  @@map("household_invites")
}

model Statement {
  id               String   @id @default(cuid())
  householdId      String   @map("household_id")
  addedByCompanyId String   @map("added_by_company_id")
  filename         String
  format           String
  importedAt       DateTime @default(now()) @map("imported_at")
  household        Household @relation(fields: [householdId], references: [id])
  expenses         Expense[]
  @@map("statements")
}

model Expense {
  id               String   @id @default(cuid())
  householdId      String   @map("household_id")
  addedByCompanyId String   @map("added_by_company_id")
  statementId      String?  @map("statement_id")
  spentOn          DateTime @map("spent_on") @db.Date
  merchant         String
  category         String
  fixed            Boolean
  amountCents      Int      @map("amount_cents")
  household        Household @relation(fields: [householdId], references: [id])
  statement        Statement? @relation(fields: [statementId], references: [id])
  @@index([householdId, spentOn])
  @@map("expenses")
}

model LessonProgress {
  companyId String  @map("company_id")
  lessonId  String  @map("lesson_id")
  completed Boolean
  company   Company @relation(fields: [companyId], references: [id])
  @@id([companyId, lessonId])
  @@map("lesson_progress")
}
