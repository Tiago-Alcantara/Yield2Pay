// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum BillType {
  software
  utility
  other
}

// ── Models ─────────────────────────────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  privyUserId String   @unique @map("privy_user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  /// Quantos grupos alheios a pessoa pode ter. Nulo vale DEFAULT_GUEST_LIMIT (1).
  guestGroupLimit Int? @map("guest_group_limit")

  wallet            Wallet?
  deposits          Deposit[]
  snapshots         YieldSnapshot[]
  bills             RecurringBill[]
  etherfuseCustomer EtherfuseCustomer?
  rampOrders        RampOrder[]
  personName         PersonName?
  ownedHouseholds    Household[] @relation("HouseholdOwner")
  householdMemberships HouseholdMember[]
  lessonProgress     LessonProgress[]
  householdWallets   HouseholdWallet[]

  @@map("companies")
}

model EtherfuseCustomer {
  id            String   @id @default(cuid())
  companyId     String   @unique @map("company_id")
  customerId    String   @map("customer_id")
  bankAccountId String?  @map("bank_account_id")
  walletId      String?  @map("wallet_id")
  kycStatus     String   @default("pending") @map("kyc_status")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("etherfuse_customers")
}

model RampOrder {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  orderId         String   @unique @map("order_id")
  type            String
  status          String   @default("created")
  amountFiat      String?  @map("amount_fiat")
  amountToken     String?  @map("amount_token")
  burnTransaction String?  @map("burn_transaction")
  depositClabe    String?  @map("deposit_clabe")
  createdAt       DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("ramp_orders")
}

model Wallet {
  id             String   @id @default(cuid())
  companyId      String   @unique @map("company_id")
  stellarAddress String   @unique @map("stellar_address")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("wallets")
}

model Deposit {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  /// USDC amount in base units (7 decimal places)
  amount    BigInt
  txHash    String   @unique @map("tx_hash")
  /// Liga o depósito à order de on-ramp (jornada Pix→cofre). Null = depósito direto.
  rampOrderId String? @map("ramp_order_id")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  // principal() agrega deposits por companyId; índice evita full-scan.
  @@index([companyId])
  @@map("deposits")
}

model RecurringBill {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  vendor      String
  /// USDC amount in base units (7 decimal places)
  monthlyCost BigInt   @map("monthly_cost")
  type        BillType @default(software)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("recurring_bills")
}

model YieldSnapshot {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  /// Vault value in base units (7 decimal places)
  vaultValue BigInt   @map("vault_value")
  /// Principal in base units (7 decimal places)
  principal  BigInt
  /// Spendable yield in base units (7 decimal places)
  spendable  BigInt
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("yield_snapshots")
}

model PersonName {
  companyId   String @id @map("company_id")
  displayName String? @map("display_name")
  fullName    String? @map("full_name")
  email       String?
  company     Company @relation(fields: [companyId], references: [id])
  @@map("person_names")
}

// Cada pessoa é dona de no máximo um grupo individual (personal = true).
// A regra vive no índice único PARCIAL "households_owner_company_id_personal_key"
// (owner_company_id) WHERE personal, criado na migration
// 20261101120000_household_multi_group. O Prisma não expressa índice parcial,
// então ele não aparece aqui.
//
// O individual pode ter membros: a migration marcou como individual o grupo que
// cada dono já tinha, com a família dentro. personal só diz que este é o grupo
// individual do DONO; para um membro, o mesmo grupo é um grupo dos outros. Por
// isso o limite de convidado da F3 (guestGroupLimit) conta só os grupos dos outros.
model Household {
  id                   String   @id @default(cuid())
  name                 String
  ownerCompanyId       String   @map("owner_company_id")
  personal             Boolean  @default(false)
  householdSize        String?  @map("household_size")
  monthlyIncomeCents   Int?     @map("monthly_income_cents")
  reserveCents         Int?     @map("reserve_cents")
  priorities           String[] @default([])
  goalMonths           Int?     @map("goal_months")
  cryptoExperience     String?  @map("crypto_experience")
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  goals                String[] @default([])
  importMode           String?  @map("import_mode")
  cryptoFamiliarity    String?  @map("crypto_familiarity")
  cryptoActions        String[] @default([]) @map("crypto_actions")
  showFreedom          Boolean  @default(true) @map("show_freedom")
  showFamily           Boolean  @default(true) @map("show_family")
  owner                Company  @relation("HouseholdOwner", fields: [ownerCompanyId], references: [id])
  members              HouseholdMember[]
  invites              HouseholdInvite[]
  statements           Statement[]
  expenses             Expense[]
  wallets              HouseholdWallet[]
  @@map("households")
}

// A pessoa pode estar em vários grupos. role só aceita 'owner' ou 'member'
// (CHECK household_members_role_check, só no SQL da migration
// 20261101120000_household_multi_group).
model HouseholdMember {
  id          String @id @default(cuid())
  householdId String @map("household_id")
  companyId   String @map("company_id")
  role        String
  createdAt   DateTime @default(now()) @map("created_at")
  household   Household @relation(fields: [householdId], references: [id])
  company     Company   @relation(fields: [companyId], references: [id])
  @@unique([householdId, companyId])
  @@index([companyId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String @id @default(cuid())
  householdId String @map("household_id")
  email       String
  status      String @default("pending")
  household   Household @relation(fields: [householdId], references: [id])
  @@map("household_invites")
}

model Statement {
  id               String   @id @default(cuid())
  householdId      String   @map("household_id")
  addedByCompanyId String   @map("added_by_company_id")
  filename         String
  format           String
  contentHash      String?  @map("content_hash")
  importedAt       DateTime @default(now()) @map("imported_at")
  household        Household @relation(fields: [householdId], references: [id])
  expenses         Expense[]
  @@unique([householdId, contentHash])
  @@map("statements")
}

model Expense {
  id               String   @id @default(cuid())
  householdId      String   @map("household_id")
  addedByCompanyId String   @map("added_by_company_id")
  statementId      String?  @map("statement_id")
  spentOn          DateTime @map("spent_on") @db.Date
  merchant         String
  /// Nula só quando kind = 'income'. O CHECK expenses_kind_category_check garante isso.
  category         String?
  fixed            Boolean
  fixedManual      Boolean  @default(false) @map("fixed_manual")
  amountCents      Int      @map("amount_cents")
  fitId            String?  @map("fit_id")
  merchantKey       String @default("") @map("merchant_key")
  sharedMerchantKey String @default("") @map("shared_merchant_key")
  /// 'expense' ou 'income', pelo CHECK expenses_kind_check.
  kind             String   @default("expense")
  /// 'manual', 'statement' ou 'wallet'.
  source           String   @default("manual")
  excludedFromTotals Boolean @default(false) @map("excluded_from_totals")
  household        Household @relation(fields: [householdId], references: [id])
  statement        Statement? @relation(fields: [statementId], references: [id])
  walletMovement   WalletMovement?
  @@unique([householdId, fitId])
  @@index([householdId, spentOn])
  @@index([householdId, sharedMerchantKey])
  @@map("expenses")
}

// Carteira Stellar só de leitura do grupo. Não tem relação com Wallet, a carteira
// B2B custodiada. muxedId nulo acompanha a conta inteira. Um unique com coluna
// nula não barra repetição no Postgres, então o índice parcial
// "household_wallets_no_muxed_key" (só no SQL da migration
// 20261104120000_household_wallets) fecha o caso sem muxedId.
model HouseholdWallet {
  id               String    @id @default(cuid())
  householdId      String    @map("household_id")
  addedByCompanyId String    @map("added_by_company_id")
  /// 'testnet' ou 'public', pelo CHECK household_wallets_network_check.
  network          String
  /// Endereço G completo. Nunca sai em resposta, log ou erro.
  accountId        String    @map("account_id")
  /// Id da subconta (uint64 em texto) de uma carteira M.
  muxedId          String?   @map("muxed_id")
  label            String
  /// paging_token da última operação gravada.
  cursor           String?
  lastSyncedAt     DateTime? @map("last_synced_at")
  /// 'pending', 'ok' ou 'updating'.
  syncStatus       String    @default("pending") @map("sync_status")
  /// Antes desta hora o sync não chama o Horizon: intervalo mínimo ou Retry-After.
  syncNotBefore    DateTime? @map("sync_not_before")
  createdAt        DateTime  @default(now()) @map("created_at")
  household        Household @relation(fields: [householdId], references: [id])
  addedBy          Company   @relation(fields: [addedByCompanyId], references: [id])
  movements        WalletMovement[]
  @@unique([householdId, network, accountId, muxedId])
  @@index([addedByCompanyId])
  @@map("household_wallets")
}

// Uma linha por operação da carteira, mais uma linha 'fee:<hash>' por transação
// paga por ela. Só class 'expense' ou 'income' com preço vira linha em expenses.
model WalletMovement {
  id            String   @id @default(cuid())
  walletId      String   @map("wallet_id")
  opId          String   @map("op_id")
  txHash        String   @map("tx_hash")
  occurredOn    DateTime @map("occurred_on") @db.Date
  /// Tipo da operação no Horizon, ou 'fee' na linha da taxa.
  opType        String   @map("op_type")
  /// 'in', 'out' ou 'none'.
  direction     String
  /// 'XLM', 'USDC' (da Circle) ou 'CODIGO:EMISSOR'. Nulo quando não há valor.
  asset         String?
  quantity      Decimal? @db.Decimal(20, 7)
  feeStroops    BigInt?  @map("fee_stroops")
  /// 'expense', 'income', 'conversion' ou 'info'.
  movementClass String   @map("class")
  /// Nulo: ainda sem preço. Zero: menos de um centavo, fica só aqui.
  valueCents    Int?     @map("value_cents")
  expenseId     String?  @unique @map("expense_id")
  createdAt     DateTime @default(now()) @map("created_at")
  wallet        HouseholdWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  @@unique([walletId, opId])
  @@index([walletId, occurredOn])
  @@map("wallet_movements")
}

// Preço em centavos de real por unidade, sempre da mainnet.
model AssetPriceDaily {
  id                String   @id @default(cuid())
  asset             String
  date              DateTime @db.Date
  priceCentsPerUnit Decimal  @map("price_cents_per_unit") @db.Decimal(20, 7)
  source            String
  createdAt         DateTime @default(now()) @map("created_at")
  @@unique([asset, date])
  @@map("asset_price_daily")
}

model LessonProgress {
  companyId  String  @map("company_id")
  lessonId   String  @map("lesson_id")
  completed  Boolean
  quizPassed Boolean @default(false) @map("quiz_passed")
  quizAnswers Json?  @map("quiz_answers")
  company    Company @relation(fields: [companyId], references: [id])
  @@id([companyId, lessonId])
  @@map("lesson_progress")
}
