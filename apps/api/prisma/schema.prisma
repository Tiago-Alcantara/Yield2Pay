// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum BillType {
  software
  utility
  other
}

// ── Models ─────────────────────────────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  privyUserId String   @unique @map("privy_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  selectedChain     String   @default("stellar") @map("selected_chain")
  unlockedChains    String[] @default(["stellar"]) @map("unlocked_chains")

  wallet            Wallet?
  deposits          Deposit[]
  snapshots         YieldSnapshot[]
  bills             RecurringBill[]
  etherfuseCustomer EtherfuseCustomer?
  rampOrders        RampOrder[]

  @@map("companies")
}

model EtherfuseCustomer {
  id            String   @id @default(cuid())
  companyId     String   @unique @map("company_id")
  customerId    String   @map("customer_id")
  bankAccountId String?  @map("bank_account_id")
  walletId      String?  @map("wallet_id")
  kycStatus     String   @default("pending") @map("kyc_status")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("etherfuse_customers")
}

model RampOrder {
  id              String   @id @default(cuid())
  companyId       String   @map("company_id")
  orderId         String   @unique @map("order_id")
  type            String
  status          String   @default("created")
  amountFiat      String?  @map("amount_fiat")
  amountToken     String?  @map("amount_token")
  burnTransaction String?  @map("burn_transaction")
  depositClabe    String?  @map("deposit_clabe")
  createdAt       DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("ramp_orders")
}

model Wallet {
  id             String   @id @default(cuid())
  companyId      String   @unique @map("company_id")
  stellarAddress String   @unique @map("stellar_address")
  solanaAddress  String?  @map("solana_address")
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("wallets")
}

model Deposit {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  /// USDC amount in base units (7 decimal places)
  amount    BigInt
  txHash    String   @unique @map("tx_hash")
  /// Venue plugin id (ex.: stellar:blend, solana:kamino).
  venueId   String   @default("stellar:blend") @map("venue_id")
  /// Liga o depósito à order de on-ramp (jornada Pix→cofre). Null = depósito direto.
  rampOrderId String? @map("ramp_order_id")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  // principal() agrega deposits por companyId (e opcionalmente venueId).
  @@index([companyId])
  @@index([companyId, venueId])
  @@map("deposits")
}

model RecurringBill {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  vendor      String
  /// USDC amount in base units (7 decimal places)
  monthlyCost BigInt   @map("monthly_cost")
  type        BillType @default(software)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("recurring_bills")
}

model YieldSnapshot {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  /// Vault value in base units (7 decimal places)
  vaultValue BigInt   @map("vault_value")
  /// Principal in base units (7 decimal places)
  principal  BigInt
  /// Spendable yield in base units (7 decimal places)
  spendable  BigInt
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@map("yield_snapshots")
}
