{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "reflect-metadata", "vitest/globals"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@yield2pay/shared": ["../../packages/shared/src/index.ts"],
      "@yield2pay/venue-core": ["../../packages/venue-core/src/index.ts"],
      "@yield2pay/venue-stellar-blend": ["../../venues/stellar-blend/src/index.ts"],
      "@yield2pay/venue-solana-kamino": ["../../venues/solana-kamino/src/index.ts"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  }
}
